# SC&SS JNU Alumni Meet Platform - Environment Configuration

# Flask Application
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# TiDB Database Configuration (MySQL Wire Protocol)
DB_HOST=localhost
DB_PORT=4000
DB_NAME=alumni_meet
DB_USER=root
DB_PASSWORD=
DB_SSL_CA=tidb-ca.pem

# External Ingestion & Drive Integration
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/your-form-id/viewform
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_NAME="Form Responses 1"
# Option A: Direct CSV link or public viewable sheet URL
GOOGLE_SHEET_CSV_URL=
# Option B: Google Service Account credentials for private sheet
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
# Sync interval in hours (Default: 24) and Auto-Sync toggle
SYNC_INTERVAL_HOURS=24
AUTO_SYNC_ENABLED=True

# Initial Admin Seed & Configurable URL Path
ADMIN_EMAIL=admin@scss-jnu.ac.in
ADMIN_PASSWORD=admin-password-change-me
ADMIN_NAME=SC&SS Organizer Admin
# Configurable Admin Path Prefix (e.g. /admin, /manage, /secret-portal)
ADMIN_PATH_PREFIX=/admin
